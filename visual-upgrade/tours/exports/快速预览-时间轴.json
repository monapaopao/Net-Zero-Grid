      "chapter": 4,
      "title": "数据中心与直流供电",
      "start": 70,
      "end": 78,
      "shot": "dcCampus",
      "scope": "campus",
      "text": "数据园区由数据中心、集中冷站、后备电源与网络运维设施共同支撑。"
    },
